# PostgreSQL 18.6; replace all placeholder credentials before use.
DATABASE_URL=postgresql://toonflow:CHANGE_ME@127.0.0.1:5432/toonflow
NODE_ENV=prod
TOONFLOW_HOST=127.0.0.1
TOONFLOW_PORT=10588
TOONFLOW_DATA_DIR=/srv/toonflow/data
# Mount NAS first, then create .toonflow-media-root inside this directory.
TOONFLOW_MEDIA_DIR=/mnt/nas/toonflow/media
# Agent gateway remains disabled until a dedicated token, owner, and scope are set.
# TOONFLOW_AGENT_TOKEN=
# TOONFLOW_AGENT_USER_ID=
# TOONFLOW_AGENT_PROJECT_IDS=
# TOONFLOW_AGENT_ALLOW_STORYBOARD_WRITE=0
